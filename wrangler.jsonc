{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "roadlens-dushanbe",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roadlens-db",
      "database_id": "23b61d03-3893-4280-b3b7-0c6adc2d7902"
    }
  ],
  "vars": {
    "INFERENCE_API_URL": "https://roadlens-yipd.onrender.com"
  },
  "observability": {
    "enabled": true
  }
}
